# ---------------------------------------------------------------------------
# Recon AI — environment variables
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- AI provider (required) -------------------------------------------------
# Provider: openai or anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# To switch to Anthropic instead:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# --- Persistent storage: ReadmeDB (required) --------------------------------
# One markdown file per firm. Used by the app and the scripts/ helpers.
READMEDB_API_KEY=rdb_...

# --- Email in/out: Resend (required for the email pipeline) -----------------
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
# Domain that inbound statement emails are addressed to (defaults to readmedb.com)
INBOUND_DOMAIN=readmedb.com

# --- Transact live API (optional — mock works without it) -------------------
# Defaults to https://api.transact-online.co.uk when unset.
TRANSACT_API_BASE=

# --- AJ Bell integration (optional) -----------------------------------------
AJBELL_PARTNER_TOKEN=
# Set to any non-empty value to show the AJ Bell option in onboarding.
NEXT_PUBLIC_AJBELL_ENABLED=

# --- Intelliflo integration (optional) --------------------------------------
INTELLIFLO_CLIENT_ID=
INTELLIFLO_CLIENT_SECRET=
INTELLIFLO_API_KEY=
# Defaults to https://api.gb.intelliflo.net when unset.
INTELLIFLO_API_BASE=
# Set to any non-empty value to show the Intelliflo option in onboarding.
NEXT_PUBLIC_INTELLIFLO_ENABLED=
